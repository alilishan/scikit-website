# Copy to .env.local for local development, and add the same keys in Vercel
# (Project → Settings → Environment Variables).

# ---------------------------------------------------------------------------
# Public business details (NEXT_PUBLIC_*): shown on the site and bundled for the browser.
# Change them in Vercel and redeploy for them to take effect.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://scikit.com.au
NEXT_PUBLIC_CONTACT_EMAIL=info@scikit.com.au
NEXT_PUBLIC_CONTACT_PHONE=
# Digits only, with country code, e.g. 61400000000
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_STREET_ADDRESS=
NEXT_PUBLIC_SUBURB=Melbourne
NEXT_PUBLIC_STATE=VIC
NEXT_PUBLIC_POSTCODE=
NEXT_PUBLIC_ABN=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
# Date shown as "Last updated" on the privacy policy and terms
NEXT_PUBLIC_LEGAL_UPDATED=28 September 2026

# ---------------------------------------------------------------------------
# Contact form email (Resend). Server-only: never exposed to the browser.
# Without RESEND_API_KEY, enquiries are only logged on the server.
# ---------------------------------------------------------------------------
# resend.com > API Keys. A "Sending access" key is enough.
RESEND_API_KEY=
# Where enquiries are delivered. Defaults to NEXT_PUBLIC_CONTACT_EMAIL.
CONTACT_TO_EMAIL=
# Sender address. Must be on a domain verified in Resend (scikit.com.au). Defaults to info@scikit.com.au.
CONTACT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (bot check on the contact form)
# Without these, the contact form rejects every submission (fails closed).
# ---------------------------------------------------------------------------
# Public site key: shown in the browser
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only secret key
TURNSTILE_SECRET=
# Hostnames the form may be submitted from, comma-separated.
# Production: scikit.com.au,www.scikit.com.au   Local: localhost,127.0.0.1 (never in production)
TURNSTILE_HOSTNAMES=
